rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidQuiz(data) {
      return data.keys().hasAll(['userId', 'subject', 'questions', 'createdAt']) &&
             data.userId is string &&
             data.subject is string &&
             data.questions is list &&
             data.createdAt is timestamp;
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(request.resource.data.userId) && isValidQuiz(request.resource.data);
    }

    match /system/api_usage {
      allow read: if isSignedIn();
      // Server writes this
      allow write: if false; 
    }

    match /logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn(); // Basic access for now
    }
  }
}
