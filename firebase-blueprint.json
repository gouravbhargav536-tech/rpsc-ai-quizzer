{
  "entities": {
    "Quiz": {
      "title": "Quiz",
      "description": "Stored quiz generated by AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "config": { "type": "object" },
        "questions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "subject", "questions", "createdAt"]
    },
    "ApiUsage": {
      "title": "API Usage",
      "description": "Tracks Gemini API usage",
      "type": "object",
      "properties": {
        "count": { "type": "number" },
        "lastUsed": { "type": "string", "format": "date-time" }
      }
    },
    "Logs": {
      "title": "System Logs",
      "description": "Error logs and system events",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["error", "info", "warning"] },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "object" }
      }
    }
  },
  "firestore": {
    "quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Quizzes generated by users"
    },
    "system/api_usage": {
      "schema": "ApiUsage",
      "description": "Global API key usage tracking"
    },
    "logs/{logId}": {
      "schema": "Logs",
      "description": "System error and info logs"
    }
  }
}
